<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta oscura inspirada en los colores de Windows 11. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#202020" />
    <SolidColorBrush x:Key="Brush.Pane" Color="#272727" />
    <SolidColorBrush x:Key="Brush.Card" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Brush.CardAlt" Color="#323232" />
    <SolidColorBrush x:Key="Brush.Stroke" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.StrokeStrong" Color="#505050" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#CFCFCF" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9D9D9D" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#60CDFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#5BBCEB" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#56AAD4" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#000000" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#1F3546" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#99EBFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Brush.Input" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF99A4" />
    <SolidColorBrush x:Key="Brush.Success" Color="#6CCB5F" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FCE100" />
    <SolidColorBrush x:Key="Brush.InfoBar.Info" Color="#1F2A35" />
    <SolidColorBrush x:Key="Brush.InfoBar.Success" Color="#2C3A21" />
    <SolidColorBrush x:Key="Brush.InfoBar.Warning" Color="#433519" />
    <SolidColorBrush x:Key="Brush.InfoBar.Error" Color="#442726" />
    <SolidColorBrush x:Key="Brush.Toast" Color="#EDEDED" />
    <SolidColorBrush x:Key="Brush.OnToast" Color="#1B1B1B" />
    <SolidColorBrush x:Key="Brush.Chip" Color="#383838" />
</ResourceDictionary>
