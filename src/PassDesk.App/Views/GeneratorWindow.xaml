<Window x:Class="PassDesk.App.Views.GeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generador de contraseñas"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}" FontSize="14" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,22">
        <TextBlock Text="Generador de contraseñas" Style="{StaticResource Text.Title}" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                   Text="Se usa el generador criptográficamente seguro de Windows. Nada se guarda ni se modifica salvo que lo decidas." />

        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Output" Style="{StaticResource TextBox.Bare}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" FontSize="17"
                         TextWrapping="Wrap" AutomationProperties.Name="Contraseña generada" />
                <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Content="&#xE72C;" ToolTip="Generar otra" Click="OnRegenerate" AutomationProperties.Name="Generar otra" />
                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE8C8;" ToolTip="Copiar" Click="OnCopy" AutomationProperties.Name="Copiar contraseña generada" />
            </Grid>
        </Border>
        <TextBlock x:Name="StrengthText" Style="{StaticResource Text.Caption}" Margin="2,6,0,0" />

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Longitud" VerticalAlignment="Center" />
            <Slider x:Name="LengthSlider" Grid.Column="1" Minimum="8" Maximum="64" Value="20" TickFrequency="1" IsSnapToTickEnabled="True"
                    Margin="14,0" VerticalAlignment="Center" ValueChanged="OnOptionsChanged" AutomationProperties.Name="Longitud" />
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=LengthSlider, StringFormat={}{0:0}}" MinWidth="26" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
        </Grid>

        <WrapPanel Margin="0,14,0,0">
            <CheckBox x:Name="UseUpper" Content="Mayúsculas (A-Z)" IsChecked="True" Margin="0,0,18,8" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
            <CheckBox x:Name="UseDigits" Content="Números (0-9)" IsChecked="True" Margin="0,0,18,8" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
            <CheckBox x:Name="UseSymbols" Content="Símbolos (!@#…)" IsChecked="True" Margin="0,0,18,8" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
            <CheckBox x:Name="AvoidAmbiguous" Content="Evitar caracteres confusos (l, 1, O, 0…)" Margin="0,0,18,8" Checked="OnOptionsChanged" Unchecked="OnOptionsChanged" />
        </WrapPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource Button.Standard}" Content="Cerrar" MinWidth="96" IsCancel="True" Click="OnClose" />
            <Button x:Name="UseButton" Style="{StaticResource Button.Accent}" Content="Usar esta contraseña" Margin="8,0,0,0" Visibility="Collapsed" Click="OnUse" />
        </StackPanel>
    </StackPanel>
</Window>
