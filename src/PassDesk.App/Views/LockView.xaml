<UserControl x:Class="PassDesk.App.Views.LockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Window}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="430" Margin="16" Padding="36,32" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Center">
                    <TextBlock x:Name="HeaderGlyph" Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.OnAccent}" />
                </Border>
                <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,6"
                           Text="PassDesk está bloqueado" />
                <TextBlock x:Name="SubHeading" Style="{StaticResource Text.Caption}" FontSize="13" TextAlignment="Center"
                           Text="Introduce tu contraseña maestra para continuar." />

                <!-- Desbloqueo -->
                <StackPanel x:Name="UnlockPanel" Margin="0,24,0,0">
                    <TextBlock Text="Contraseña maestra" Style="{StaticResource Text.FieldLabel}" />
                    <PasswordBox x:Name="UnlockPassword" MinHeight="36" AutomationProperties.Name="Contraseña maestra" KeyDown="OnUnlockKeyDown" />
                    <TextBlock x:Name="UnlockError" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0" Visibility="Collapsed" />
                    <Button x:Name="ArchiveButton" Style="{StaticResource Button.Subtle}" HorizontalAlignment="Left" Margin="-10,6,0,0" Visibility="Collapsed"
                            Content="Empezar con una bóveda nueva y restaurar una copia…" Foreground="{DynamicResource Brush.AccentText}" Click="OnArchiveVault" />
                    <Button x:Name="UnlockButton" Style="{StaticResource Button.Accent}" Content="Desbloquear" MinHeight="36" Margin="0,16,0,0" Click="OnUnlockClick"
                            AutomationProperties.Name="Desbloquear" />
                    <Button x:Name="HelloButton" Style="{StaticResource Button.Standard}" MinHeight="36" Margin="0,8,0,0" Click="OnHelloClick" Visibility="Collapsed"
                            AutomationProperties.Name="Usar Windows Hello">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE928;" />
                            <TextBlock Text="Usar Windows Hello" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Primera ejecución -->
                <StackPanel x:Name="SetupPanel" Margin="0,24,0,0" Visibility="Collapsed">
                    <TextBlock Text="Nueva contraseña maestra" Style="{StaticResource Text.FieldLabel}" />
                    <PasswordBox x:Name="NewPassword" MinHeight="36" PasswordChanged="OnSetupPasswordChanged" AutomationProperties.Name="Nueva contraseña maestra" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Strength1" Grid.Column="0" Height="4" CornerRadius="2" Margin="0,0,3,0" Background="{DynamicResource Brush.Stroke}" />
                        <Border x:Name="Strength2" Grid.Column="1" Height="4" CornerRadius="2" Margin="3,0,3,0" Background="{DynamicResource Brush.Stroke}" />
                        <Border x:Name="Strength3" Grid.Column="2" Height="4" CornerRadius="2" Margin="3,0,3,0" Background="{DynamicResource Brush.Stroke}" />
                        <Border x:Name="Strength4" Grid.Column="3" Height="4" CornerRadius="2" Margin="3,0,0,0" Background="{DynamicResource Brush.Stroke}" />
                    </Grid>
                    <TextBlock x:Name="StrengthText" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="Mínimo 12 caracteres y fortaleza «Fuerte». Mejor una frase de 4 o más palabras con algún número o símbolo." />

                    <TextBlock Text="Repite la contraseña" Style="{StaticResource Text.FieldLabel}" Margin="0,14,0,3" />
                    <PasswordBox x:Name="ConfirmPassword" MinHeight="36" PasswordChanged="OnSetupPasswordChanged" KeyDown="OnSetupKeyDown" AutomationProperties.Name="Repetir contraseña maestra" />
                    <TextBlock x:Name="SetupError" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0" Visibility="Collapsed" />

                    <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.InfoBar.Warning}" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text}"
                                   Text="Si olvidas la contraseña maestra no se puede recuperar la bóveda de PassDesk (tus contraseñas seguirán en el iPhone). Guárdala en un lugar seguro." />
                    </Border>
                    <Button x:Name="CreateButton" Style="{StaticResource Button.Accent}" Content="Crear bóveda cifrada" MinHeight="36" Margin="0,16,0,0"
                            IsEnabled="False" Click="OnCreateClick" AutomationProperties.Name="Crear bóveda cifrada" />
                </StackPanel>

                <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Margin="0,14,0,0" Visibility="Collapsed" />

                <TextBlock Style="{StaticResource Text.Caption}" TextAlignment="Center" Margin="0,22,0,0"
                           Text="Los datos se guardan cifrados solo en este equipo (AES-256-GCM + DPAPI de Windows). Nada se envía a internet." />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
