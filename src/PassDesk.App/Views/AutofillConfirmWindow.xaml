<Window x:Class="PassDesk.App.Views.AutofillConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassDesk · Confirmar relleno"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}" FontSize="14" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,22">
        <TextBlock Text="¿Rellenar en el navegador?" Style="{StaticResource Text.Title}" FontSize="20" />
        <TextBlock x:Name="Summary" Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap" />
        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Cuenta" Style="{StaticResource Text.FieldLabel}" />
                <TextBlock x:Name="AccountText" TextWrapping="Wrap" />
                <TextBlock Text="Usuario" Style="{StaticResource Text.FieldLabel}" Margin="0,8,0,0" />
                <TextBlock x:Name="UserText" TextWrapping="Wrap" />
                <TextBlock Text="Página del navegador" Style="{StaticResource Text.FieldLabel}" Margin="0,8,0,0" />
                <TextBlock x:Name="OriginText" TextWrapping="Wrap" FontWeight="SemiBold" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="Warning" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Solo si la página que ves es la que esperas. Si no la reconoces o no has pedido nada, pulsa Cancelar." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource Button.Standard}" Content="Cancelar" MinWidth="96" IsCancel="True" IsDefault="True" />
            <Button x:Name="AllowButton" Style="{StaticResource Button.Accent}" Content="_Permitir" MinWidth="110" Margin="8,0,0,0" Click="OnAllow" />
        </StackPanel>
    </StackPanel>
</Window>
