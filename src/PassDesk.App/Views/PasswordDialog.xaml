<Window x:Class="PassDesk.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassDesk"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}" FontSize="14" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,22">
        <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" FontSize="20" TextWrapping="Wrap" />
        <TextBlock x:Name="Description" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />

        <TextBlock x:Name="FirstLabel" Style="{StaticResource Text.FieldLabel}" Margin="0,16,0,3" />
        <PasswordBox x:Name="FirstBox" MinHeight="34" AutomationProperties.Name="Contraseña" />

        <StackPanel x:Name="ChangePanel" Visibility="Collapsed">
            <TextBlock Text="Nueva contraseña maestra" Style="{StaticResource Text.FieldLabel}" Margin="0,12,0,3" />
            <PasswordBox x:Name="NewBox" MinHeight="34" AutomationProperties.Name="Nueva contraseña maestra" />
            <TextBlock Text="Repite la nueva contraseña" Style="{StaticResource Text.FieldLabel}" Margin="0,12,0,3" />
            <PasswordBox x:Name="ConfirmBox" MinHeight="34" AutomationProperties.Name="Repetir nueva contraseña" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                       Text="Mínimo 12 caracteres y fortaleza «Fuerte» (mejor una frase de 4 o más palabras). Se generará una clave de cifrado nueva; las copias de seguridad antiguas seguirán abriéndose con la contraseña anterior." />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="0,10,0,0" Visibility="Collapsed" />
        <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource Button.Standard}" Content="Cancelar" MinWidth="96" IsCancel="True" />
            <Button x:Name="AcceptButton" Style="{StaticResource Button.Accent}" Content="Aceptar" MinWidth="110" Margin="8,0,0,0" IsDefault="True" Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
