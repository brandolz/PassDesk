<Window x:Class="PassDesk.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes"
        Width="640" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}" FontSize="14" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,12">
                <TextBlock Text="Ajustes" Style="{StaticResource Text.Title}" />

                <!-- Seguridad -->
                <TextBlock Text="Seguridad" Style="{StaticResource Text.Subtitle}" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Bloqueo automático por inactividad" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="Borra de memoria las credenciales descifradas." />
                            </StackPanel>
                            <ComboBox x:Name="AutoLockBox" Grid.Column="1" MinWidth="140" AutomationProperties.Name="Bloqueo automático" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Borrar el portapapeles tras copiar" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="Solo si sigue conteniendo lo que copió PassDesk. Excluido del historial de Win+V." />
                            </StackPanel>
                            <ComboBox x:Name="ClipboardBox" Grid.Column="1" MinWidth="140" AutomationProperties.Name="Borrado del portapapeles" />
                        </Grid>
                        <CheckBox x:Name="HelloCheck" Margin="0,16,0,0" Content="Desbloqueo rápido con Windows Hello" />
                        <TextBlock x:Name="HelloStatus" Style="{StaticResource Text.Caption}" Margin="28,2,0,0"
                                   Text="Durante 8 horas tras escribir la contraseña maestra podrás usar rostro, huella o PIN. Ojo: en ese tiempo, quien conozca el PIN de Windows podrá abrir PassDesk. Tras bloquear Windows, suspender el equipo o reiniciar PassDesk, siempre se pide la contraseña maestra." />
                        <CheckBox x:Name="SessionLockCheck" Margin="0,12,0,0" Content="Bloquear al bloquear Windows (Win+L) o suspender el equipo" />
                        <CheckBox x:Name="MinimizeLockCheck" Margin="0,10,0,0" Content="Bloquear al minimizar la ventana o pasarla a la bandeja" />
                        <CheckBox x:Name="CaptureCheck" Margin="0,10,0,0" Content="Ocultar PassDesk en capturas de pantalla, grabaciones y al compartir pantalla" />
                        <Button Style="{StaticResource Button.Standard}" Content="Cambiar contraseña maestra…" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnChangePassword" />
                    </StackPanel>
                </Border>

                <!-- Apariencia -->
                <TextBlock Text="Apariencia" Style="{StaticResource Text.Subtitle}" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Según Windows" Margin="0,0,20,0" />
                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Claro" Margin="0,0,20,0" />
                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Oscuro" />
                    </StackPanel>
                </Border>

                <!-- Búsqueda rápida -->
                <TextBlock Text="Búsqueda rápida" Style="{StaticResource Text.Subtitle}" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel>
                        <CheckBox x:Name="HotkeyCheck" Content="Abrir la ventana compacta de búsqueda con un atajo global" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Atajo" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" MinHeight="34" PreviewKeyDown="OnHotkeyKeyDown"
                                     AutomationProperties.Name="Atajo de teclado" ToolTip="Haz clic aquí y pulsa la combinación de teclas" />
                        </Grid>
                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   Text="Haz clic en el cuadro y pulsa la combinación (debe incluir Ctrl, Alt, Mayús o Win)." />
                    </StackPanel>
                </Border>

                <!-- Bandeja del sistema e inicio con Windows -->
                <TextBlock Text="Bandeja del sistema" Style="{StaticResource Text.Subtitle}" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" FontSize="13"
                                   Text="PassDesk tiene un icono junto al reloj (Abrir, Bloquear ahora, Búsqueda rápida, Salir) para que la búsqueda rápida funcione sin la ventana abierta. El icono nunca muestra datos de tus cuentas." />
                        <RadioButton x:Name="TrayOnClose" GroupName="Tray" Margin="0,12,0,0" Content="Al cerrar la ventana, seguir en la bandeja" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="28,2,0,0" Text="Para salir del todo, usa «Salir» en el menú del icono." />
                        <RadioButton x:Name="TrayOnMinimize" GroupName="Tray" Margin="0,10,0,0" Content="Al minimizar, ocultar la ventana en la bandeja" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="28,2,0,0" Text="Cerrar la ventana sale de PassDesk." />
                        <CheckBox x:Name="StartupCheck" Margin="0,14,0,0" Content="Iniciar con Windows" />
                        <TextBlock x:Name="StartupStatus" Style="{StaticResource Text.Caption}" Margin="28,2,0,0"
                                   Text="Al iniciar sesión, PassDesk se abre en la bandeja, sin ventana y bloqueado." />
                    </StackPanel>
                </Border>

                <!-- Actualizaciones desde Apple -->
                <TextBlock Text="Actualizaciones desde Apple" Style="{StaticResource Text.Subtitle}" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel>
                        <CheckBox x:Name="DetectExportsCheck" Content="Detectar exportaciones nuevas en Escritorio, Descargas y Documentos" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="28,2,0,0"
                                   Text="Al guardar ahí una exportación de Apple, PassDesk abre la vista previa sin que tengas que buscarla. Solo lee la cabecera de los archivos CSV o ZIP para reconocerlos." />
                        <CheckBox x:Name="DeleteExportCheck" Margin="0,12,0,0" Content="Eliminar de forma segura la exportación después de importarla" />
                        <CheckBox x:Name="ReminderCheck" Margin="0,10,0,0" Content="Recordarme actualizar si pasan 30 días sin importar" />
                    </StackPanel>
                </Border>

                <!-- Copias de seguridad -->
                <TextBlock Text="Copias de seguridad" Style="{StaticResource Text.Subtitle}" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" FontSize="13"
                                   Text="La copia está cifrada con tu contraseña maestra actual (Argon2id + AES-256-GCM). No usa la protección de Windows (DPAPI), así que puedes restaurarla en otro equipo, pero quien la consiga puede intentar adivinar tu contraseña maestra sin límite de intentos. Guárdala en un lugar que solo controles tú y usa una contraseña maestra fuerte." />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource Button.Standard}" Content="Exportar copia cifrada…" Margin="0,0,8,6" Click="OnExportBackup" />
                            <Button Style="{StaticResource Button.Standard}" Content="Restaurar copia…" Margin="0,0,8,6" Click="OnRestoreBackup" />
                            <Button Style="{StaticResource Button.Standard}" Content="Puntos de recuperación…" Margin="0,0,8,6" Click="OnRestoreRecoveryPoint"
                                    ToolTip="Copias automáticas de la bóveda guardadas antes de cada importación o restauración" />
                        </WrapPanel>
                        <TextBlock x:Name="BackupStatus" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Privacidad -->
                <TextBlock Text="Datos y privacidad" Style="{StaticResource Text.Subtitle}" Margin="0,22,0,8" />
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" FontSize="13" TextWrapping="Wrap">
                            <Run Text="Carpeta de datos: " /><Run x:Name="DataFolder" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,6,0,0"
                                   Text="Sin telemetría ni conexiones a internet. Los registros solo contienen eventos y contadores, nunca contraseñas, usuarios ni sitios." />
                        <TextBlock Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,6,0,0"
                                   Text="Sincronización automática: no disponible. Apple no ofrece una API pública para leer las contraseñas de iCloud o del iPhone desde otras aplicaciones." />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0" Text="PassDesk 1.0 · Uso personal · No afiliado a Apple Inc." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Standard}" Content="Cancelar" MinWidth="96" IsCancel="True" />
                <Button Style="{StaticResource Button.Accent}" Content="Guardar" MinWidth="110" Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
