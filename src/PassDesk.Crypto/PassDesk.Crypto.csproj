<Project Sdk="Microsoft.NET.Sdk">
  <!-- Módulo de cifrado: AES-256-GCM, PBKDF2, DPAPI y protección de secretos en memoria. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PassDesk.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <!-- Argon2id mediante libsodium (biblioteca auditada); NSec es su envoltorio para .NET. -->
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
  </ItemGroup>
</Project>