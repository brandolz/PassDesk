<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mismo destino que la app para poder probar sus componentes de interfaz (WPF). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- x64 explícito: libsodium (Argon2id) queda junto a la DLL de pruebas en vez de en runtimes\…\native, cuya
         ruta supera el límite de 260 caracteres del proceso de pruebas (que no admite rutas largas). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Los proyectos WPF no importan System.IO de forma implícita. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PassDesk.Crypto\PassDesk.Crypto.csproj" />
    <ProjectReference Include="..\..\src\PassDesk.Core\PassDesk.Core.csproj" />
    <ProjectReference Include="..\..\src\PassDesk.Storage\PassDesk.Storage.csproj" />
    <ProjectReference Include="..\..\src\PassDesk.Auth\PassDesk.Auth.csproj" />
    <ProjectReference Include="..\..\src\PassDesk.Import\PassDesk.Import.csproj" />
    <ProjectReference Include="..\..\src\PassDesk.App\PassDesk.App.csproj" />
  </ItemGroup>

</Project>
