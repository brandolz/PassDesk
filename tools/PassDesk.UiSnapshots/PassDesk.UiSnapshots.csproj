<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Herramienta de desarrollo: abre las ventanas reales de PassDesk con datos ficticios en un perfil
    temporal y las renderiza a PNG por software (sirve aunque la sesión de Windows esté bloqueada).
    No forma parte de la aplicación distribuida.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- x64 explícito: libsodium (Argon2id) queda junto al ejecutable y no en una ruta de más de 260 caracteres. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PassDesk.App\PassDesk.App.csproj" />
  </ItemGroup>

</Project>
